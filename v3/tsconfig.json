{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["platform/**/src/**/*.ts", "platform/**/tests/**/*.ts", "products/golms/src/**/*.ts", "products/golms/tests/**/*.ts"]
}
