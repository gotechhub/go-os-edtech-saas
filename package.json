{
  "name": "go-os-edtech-saas",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "corepack pnpm --filter @respongo-os/web dev",
    "build": "corepack pnpm --filter @respongo-os/web build",
    "typecheck": "tsc -p tsconfig.json && corepack pnpm --filter @respongo-os/web typecheck",
    "test": "vitest run --config vitest.config.ts",
    "tracker:update": "node scripts/update-project-tracker.mjs",
    "tracker:check": "node scripts/update-project-tracker.mjs --check",
    "structure:check": "node scripts/check-structure.mjs",
    "check": "corepack pnpm tracker:check && corepack pnpm structure:check && corepack pnpm test && corepack pnpm typecheck && corepack pnpm build"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "24.10.1",
    "next": "16.3.5",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
