# Public browser-safe Supabase configuration. Real values belong in local/Vercel secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only deployment values. Never prefix these with NEXT_PUBLIC_.
SUPABASE_PROJECT_REF=
SUPABASE_DB_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel OIDC role. Kalıcı AWS access key kullanılmaz.
AWS_REGION=eu-north-1
AWS_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/respongo-vercel-storage-app
S3_SYSTEM_BUCKET=saas-edtech-platform-360
S3_TENANT_BUCKET_PREFIX=respongo-tenant
S3_UPLOAD_URL_TTL_SECONDS=300
S3_DOWNLOAD_URL_TTL_SECONDS=300

# SCORM player must use a separate host in production. The app origin is the only allowed embedder.
SCORM_PLAYER_ORIGIN=http://127.0.0.1:3003
RESPONGO_APP_ORIGIN=http://127.0.0.1:3003
